  <!-- ================= JAVASCRIPT ================= -->
  <script>
    // Dynamic Copyright Year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });

    // EDIT HERE: Client Testimonials Data
    const testimonials = [
      {
        quote:
          '“Working with Arian transformed our product. He rebuilt our entire SaaS dashboard ahead of schedule, cutting load times in half while elevating the UI to an enterprise level.”',
        name: 'Sarah Jenkins',
        role: 'VP of Product, MetricFlow (USA)',
        initials: 'SJ',
      },
      {
        quote:
          '“Rarely do you find a developer who understands both deep backend architecture and refined UI/UX design. Every sprint was transparent, fast, and bug-free.”',
        name: 'Marcus Vance',
        role: 'Founder & CEO, FinVault (UK)',
        initials: 'MV',
      },
      {
        quote:
          '“Our conversion rate jumped by 34% within the first month after launching the new web app Arian designed and engineered for us.”',
        name: 'Nadia Karim',
        role: 'Head of Growth, ShopSphere',
        initials: 'NK',
      },
    ];

    let currentSlide = 0;
    const track = document.getElementById('testimonial-track');
    const dotsContainer = document.getElementById('testimonial-dots');

    function renderTestimonial(index) {
      const item = testimonials[index];
      track.style.opacity = 0;

      setTimeout(() => {
        track.innerHTML = `
          <div class="max-w-3xl">
            <div class="mb-6 flex gap-1 text-neon-blue text-lg">★★★★★</div>
            <blockquote class="text-lg font-medium leading-relaxed text-slate-200 sm:text-2xl">
              ${item.quote}
            </blockquote>
            <div class="mt-8 flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border border-neon-blue/40 bg-neon-blue/10 font-mono text-sm font-bold text-neon-blue">
                ${item.initials}
              </div>
              <div>
                <p class="font-bold text-white">${item.name}</p>
                <p class="text-sm text-slate-400">${item.role}</p>
              </div>
            </div>
          </div>
        `;
        track.style.opacity = 1;
      }, 150);

      // Update Dots
      dotsContainer.innerHTML = testimonials
        .map(
          (_, idx) => `
          <button
            onclick="goToSlide(${idx})"
            aria-label="Go to testimonial ${idx + 1}"
            class="h-2 rounded-full transition-all ${
              idx === index ? 'w-8 bg-neon-blue' : 'w-2 bg-slate-700 hover:bg-slate-500'
            }"
          ></button>
        `
        )
        .join('');
    }

    function goToSlide(index) {
      currentSlide = index;
      renderTestimonial(currentSlide);
    }

    document.getElementById('prev-testimonial').addEventListener('click', () => {
      currentSlide = (currentSlide - 1 + testimonials.length) % testimonials.length;
      renderTestimonial(currentSlide);
    });

    document.getElementById('next-testimonial').addEventListener('click', () => {
      currentSlide = (currentSlide + 1) % testimonials.length;
      renderTestimonial(currentSlide);
    });

    renderTestimonial(0);

    // Contact Form Submission Handler (Demo Mode)
    const contactForm = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const formStatus = document.getElementById('form-status');

    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      setTimeout(() => {
        contactForm.reset();
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Send Message <span>&rarr;</span>';
        formStatus.classList.remove('hidden');

        setTimeout(() => {
          formStatus.classList.add('hidden');
        }, 5000);
      }, 800);
    });
  </script>
